---
import { ORGANIZATIONAL_PAGES } from "../const";

import Scaffold from "../layout/Scaffold.astro";
import ContentHead from "../components/ContentHead.astro";

const PAGE = ORGANIZATIONAL_PAGES[0];
---

<Scaffold>
  <ContentHead
    slot="head"
    type="website"
    title={PAGE.title}
    description={PAGE.description}
  />
  <div>Em breve teremos algo bacana por aqui!!!</div>
</Scaffold>

<style>
  div {
    display: flex;
    height: 70vh;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-size: 1.4rem;
    font-weight: bold;
  }
</style>
