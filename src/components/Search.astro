<div class="search hidden">
    <div class="searchBox">
        <div class="bar">
            <span>Pesquise com o Google</span>
            <button class="closeSearch">X</button>
        </div>
        <script
            id="google-search-script"
            type="text/javascript-lazy"
            data-src={"https://cse.google.com/cse.js?cx=" +
                import.meta.env.GOOGLE_SEARCH_ID}></script>
        <div class="gcse-search"></div>
    </div>
</div>

<script>
    import { animation } from "../scripts/animation";
    import Search from "../scripts/search";
    import Cookies from "../scripts/cookies";

    const inputSearch = document.querySelector(".search");
    const closeSearch = document.querySelector(".closeSearch");

    const googleScript = document.querySelector(
        "#google-search-script",
    ) as HTMLScriptElement;

    Search.onOpen(() => {
        animation.start("appear-top", inputSearch);
    });

    Search.onClose(() => animation.end("desappear-top", inputSearch));

    Cookies.onSearchPermitted(() => {
        if (googleScript && googleScript.dataset.src) {
            const newScript = document.createElement("script");
            newScript.src = googleScript.dataset.src;
            newScript.type = "text/javascript";

            document.body.appendChild(newScript);

            googleScript.remove();
        }
    });

    closeSearch?.addEventListener("click", () => Search.close());
</script>

<style>
    .search {
        width: 100vw;
        display: flex;
        justify-content: center;
        position: fixed;
        z-index: 3;
        top: 20px;
    }

    .searchBox {
        width: 700px;
        padding: 10px;
        background: #fff;
        color: #000;
        border: 1px solid #ccc;
    }

    .bar {
        display: flex;
        justify-content: space-between;
    }

    button {
        border: none;
        background: #ccc;
        color: #000;
        font-weight: bold;
        border-radius: 5px;
        transition: background 0.3s ease-in-out;
    }

    button:hover {
        background: red;
    }
</style>
