---
import { ORGANIZATIONAL_PAGES } from "../const";
---

<div class="cookie hidden">
    <div class="cookie-card">
        <span
            >Esse site usa cookies de terceiros para algumas funcionalidades.
            Você pode conferir nossa <a
                href={ORGANIZATIONAL_PAGES[2].page}
                title={ORGANIZATIONAL_PAGES[2].link_description}
                >política de privacidade</a
            > para mais informações. Deixe marcado caso você aceite permitir:</span
        >

        <div>
            <label>
                <input type="checkbox" checked class="acS" /> Cookies para usar a
                barra de pesquisa do Google.
            </label>

            <label>
                <input type="checkbox" checked class="acA" /> Cookies do Google Analytics.
            </label>

            <label>
                <input type="checkbox" checked class="acAds" /> Cookies do Google
                Adsense.
            </label>
            <label>
                Caso você não permita Cookies do Google Adsense, os anúncios
                seram exibidos no modo estrito.
            </label>
            <label>
                <button class="close-cookies">Fechar</button>
            </label>
        </div>
    </div>
</div>

<script>
    import Cookies from "../scripts/cookies";
    import CookieCard from "../scripts/cookieCard";

    const cookies = new Cookies();

    const cookiesCard = document.querySelector(".cookie");
    const adsInput = document.querySelector(".acAds") as HTMLInputElement;
    const analitycsInput = document.querySelector(".acA") as HTMLInputElement;
    const searchInput = document.querySelector(".acS") as HTMLInputElement;
    const closeCookies = document.querySelector(".close-cookies");

    function load_inputs_state() {
        const { ads, analitycs, search } = cookies.get_status();

        adsInput.checked = ads;
        analitycsInput.checked = analitycs;
        searchInput.checked = search;
    }

    CookieCard.onOpen(() => {
        console.log("evento abrir");
        load_inputs_state();
        cookiesCard?.classList.remove("hidden");
    });

    CookieCard.onClose(() => {
        cookiesCard?.classList.add("hidden");
    });

    closeCookies?.addEventListener("click", () => {
        cookies.set_and_emit_status(
            adsInput.checked,
            analitycsInput.checked,
            searchInput.checked,
        );

        CookieCard.close();
    });

    if (!cookies.get_hidden_card()) {
        CookieCard.open();
    }
</script>

<style>
    .cookie {
        width: 100vw;
        position: fixed;
        bottom: 40px;
        left: 0px;
        display: flex;
        justify-content: center;
    }
    .cookie-card {
        padding: 15px;
        width: 600px;
        border: 1px solid #555;
        border-radius: 5px;
        text-align: justify;
        font-size: 0.9rem;
        background: var(--bg-color);
    }

    label {
        display: block;
        padding: 5px 10px;
    }

    label:first-of-type,
    label:last-of-type {
        margin-top: 10px;
    }

    label:last-of-type {
        text-align: center;
    }

    a {
        text-decoration: underline;
        transition: 0.3s color;
    }

    a:hover {
        color: var(--secundary-color);
    }

    @media (max-width: 650px) {
        .cookie-card {
            width: 95vw;
            box-sizing: border-box;
        }
    }
</style>
