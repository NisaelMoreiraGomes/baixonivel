---
import { SITE_CONFIG } from "../const";

interface Props {
    locale?: string;
    type?: string;
    title: string;
    description: string;
    thumb?: {
        resource: ImageMetadata;
        description: string;
    };
}

const {
    locale = SITE_CONFIG.lang,
    type = "article",
    title,
    description,
    thumb,
} = Astro.props;
---

<title>{title}</title>

<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

<meta property="og:locale" content={locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={Astro.url} />
<meta property="og:site_name" content={SITE_CONFIG.name} />
{
    thumb && (
        <meta
            property="og:image"
            content={new URL(thumb.resource.src, Astro.site)}
        />
    )
}
{
    thumb && (
        <meta
            property="og:image:width"
            content={thumb.resource.width.toString()}
        />
    )
}
{
    thumb && (
        <meta
            property="og:image:height"
            content={thumb.resource.height.toString()}
        />
    )
}
{thumb && <meta property="og:image:alt" content={thumb.description} />}
{thumb && <meta name="twitter:card" content="summary_large_image" />}
